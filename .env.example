# Zotero Knowledge Base Engine Configuration Template
# Copy this file to .env and fill in your details.

# Your Mistral API Key for OCR (Get it from console.mistral.ai)
MISTRAL_API_KEY=your_api_key_here

# Path to your exported Zotero BibTeX library file
BIB_FILE_PATH=./library.bib

# Path to your Zotero storage folder
ZOTERO_STORAGE_PATH=./storage

# Directory where generated Markdown files will be saved
OUTPUT_MD_DIR=./markdown_database/

# Path for the missing entries log file
LOG_FILE=./markdown_database/missing_log.txt

# Number of concurrent workers
MAX_WORKERS=6
